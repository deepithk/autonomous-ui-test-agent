# Quick start: set LLM_API_KEY below. Everything else is already filled
# in for the public SauceDemo test site.

# LLM provider: gemini or anthropic
LLM_PROVIDER=gemini
# Examples: gemini-3.5-flash-lite (gemini), claude-sonnet-5-5 (anthropic)
LLM_MODEL=gemini-3.5-flash-lite
# Your API key for the provider above
LLM_API_KEY=

# Target web application and its public demo login
TARGET_BASE_URL=https://www.saucedemo.com
SAUCEDEMO_USERNAME=standard_user
SAUCEDEMO_PASSWORD=secret_sauce

# Playwright MCP
PLAYWRIGHT_MCP_HEADLESS=true
PLAYWRIGHT_MCP_CAPS=testing

# Execution guardrails
MAX_STEPS_PER_SCENARIO=15
SCENARIO_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=10000
MAX_ELEMENT_RECOVERY_ATTEMPTS=2

# Repair a step once before failing it (see TEST_PLAN.md, section 9.3)
SELF_HEALING=true

# ------------------------------------------------------------------
# Optional: only needed to read the issue from GitHub (npm run plan:issue
# without --issue-file). Not needed to execute a saved plan, or to plan
# from the local file fixtures/issue-1.md.
# ------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ISSUE_NUMBER=
GITHUB_RFQA_STATUS_VALUE=RFQA
GITHUB_RFQA_FALLBACK_LABEL=true
GITHUB_PROJECT_NUMBER=1
