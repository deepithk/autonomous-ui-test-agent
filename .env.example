# Anthropic Runtime AI Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# GitHub Integration Configuration
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_ISSUE_NUMBER=
GITHUB_RFQA_STATUS_VALUE=RFQA
GITHUB_RFQA_FALLBACK_LABEL=true
GITHUB_PROJECT_NUMBER=1

# Target Web Application
TARGET_BASE_URL=

# SauceDemo Test Account
SAUCEDEMO_USERNAME=
SAUCEDEMO_PASSWORD=

# Playwright MCP Configuration
PLAYWRIGHT_MCP_HEADLESS=true
PLAYWRIGHT_MCP_CAPS=testing

# Execution Guardrails
MAX_STEPS_PER_SCENARIO=15
SCENARIO_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=10000
MAX_ELEMENT_RECOVERY_ATTEMPTS=2