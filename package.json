{
  "name": "autonomous-ui-test-agent",
  "version": "0.1.0",
  "description": "Cross-platform Autonomous UI Test Execution Agent using Claude API and Playwright MCP",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.0 || ^26.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "read:issue": "tsx src/github/run-issue-reader.ts",
    "plan:issue": "tsx src/planner/run-test-planner.ts",
    "execute:plan": "tsx src/executor/run-test-execution.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "^0.0.85",
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
